# Envío del formulario de contacto (opcional).
# Sin estas variables, las solicitudes solo se registran en los logs del servidor.
# Creá una cuenta en https://resend.com, verificá tu dominio y pegá la API key.
RESEND_API_KEY=
# Destinatario de las solicitudes (por defecto: siteConfig.email)
CONTACT_TO_EMAIL=
# Remitente verificado en Resend, p. ej. "Ejwebs <hola@tudominio.com>"
CONTACT_FROM_EMAIL=
